{
  "expo": {
    "name": "HakikaRide Parent",
    "slug": "hakikaride-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "hakikaride-parent",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FEC601"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hakikaride.parent"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEC601"
      },
      "package": "com.hakikaride.parent"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
